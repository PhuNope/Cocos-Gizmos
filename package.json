{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "cocos-gizmos",
    "version": "2.0.3",
    "author": "Nope",
    "editor": ">=3.8.2",
    "scripts": {
        "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs && tsc -p tsconfig.assets.json --noEmit",
        "type": "npm run build && node scripts/type.mjs",
        "prepublishOnly": "npm run type",
        "test": "npm run type && node scripts/verify-output.mjs && node tests/extension-types.mjs && node tests/mounted-examples.mjs && node tests/optional-extension.mjs && node tests/scene-scheduler.mjs && node tests/scene-discovery.mjs && node tests/presentation.mjs && node tests/hud-layout.mjs && node tests/hud-overlay.mjs && node tests/hud-projection.mjs && node tests/hud-controls.mjs && node tests/panel-settings.mjs && node tests/gizmo-diagnostics.mjs && node tests/gizmo-edit-session.mjs && node tests/position-drag.mjs && node tests/scene-gizmo-input.mjs && node tests/position-adapter.mjs && node tests/draw-commands-2d.mjs && node tests/renderer-3d.mjs && node tests/editor-only.mjs && node tests/mesh-positions.mjs",
        "pack": "npm run test && node scripts/pack.mjs"
    },
    "types": "dist/Gizmos.d.ts",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@cocos/creator-types": "^3.8.2",
        "@types/fs-extra": "^9.0.5",
        "@types/node": "^18.17.1",
        "fs-extra": "^10.0.0",
        "typescript": "^6.0.3",
        "vue": "^3.1.4"
    },
    "contributions": {
        "scene": {
            "script": "./scene.js"
        },
        "builder": "./builder.js",
        "asset-db": {
            "mount": {
                "path": "./editor-assets",
                "readonly": true
            }
        },
        "menu": [
            {
                "path": "i18n:menu.extension/Gizmos Settings",
                "label": "Gizmos Settings",
                "message": "open-settings"
            }
        ],
        "messages": {
            "open-settings": {
                "methods": [
                    "openSettings"
                ]
            },
            "get-settings": {
                "methods": [
                    "getSettings"
                ]
            },
            "set-settings": {
                "methods": [
                    "setSettings"
                ]
            },
            "get-diagnostics": {
                "methods": [
                    "getDiagnostics"
                ]
            }
        }
    },
    "main": "./main.js",
    "panels": {
        "settings": {
            "title": "Gizmos Settings",
            "type": "dockable",
            "main": "./panels/settings/index.js"
        }
    }
}
