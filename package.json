{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "cocos-gizmos",
    "version": "2.0.0",
    "author": "Nope",
    "editor": ">=3.8.2",
    "scripts": {
        "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs && tsc -p tsconfig.assets.json --noEmit",
        "type": "npm run build && node scripts/type.mjs",
        "prepublishOnly": "npm run type",
        "test": "npm run type && node scripts/verify-output.mjs",
        "pack": "npm run test && node scripts/pack.mjs"
    },
    "types": "dist/Gizmos.d.ts",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@cocos/creator-types": "^3.8.2",
        "@types/fs-extra": "^9.0.5",
        "@types/node": "^18.17.1",
        "fs-extra": "^10.0.0",
        "typescript": "^6.0.3",
        "vue": "^3.1.4"
    },
    "contributions": {
        "asset-db": {
            "mount": {
                "path": "./dist",
                "readonly": true
            }
        }
    }
}
