{
    /* Type-checks the generated bundle (.generated/Gizmos.ts) and sample after `node scripts/build.mjs`. */
    "extends": "./base.tsconfig.json",

    "compilerOptions": {
        "strict": false,
        "lib": ["ES2016", "DOM"],
        "rootDir": ".",
        "noEmit": true
    },

    "include": [".generated/**/*.ts", "assets/Example.ts", "Types/**/*"]
}
